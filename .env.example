# Credenciales del laboratorio como variables de entorno.
#
#   cp .env.example .env
#   chmod 600 .env          # solo su usuario puede leerlo
#   nano .env               # completar los valores
#   source .env             # en cada terminal nueva, desde esta carpeta
#
# .env NUNCA se sube a git ni se entrega (está en .gitignore).
# "export" es necesario: sin él, aws y tofu no ven la variable.

# --- AWS ---------------------------------------------------------------------
# Cuenta propia: claves del usuario IAM (Parte 0, opción A).
# Learner Lab: AWS Details -> AWS CLI -> Show (Parte 0, opción B). Vencen en
# cada sesión: actualizar las tres líneas y volver a hacer "source .env".
export AWS_ACCESS_KEY_ID=""
export AWS_SECRET_ACCESS_KEY=""
export AWS_SESSION_TOKEN=""   # solo Learner Lab; con cuenta propia, borrar esta línea
export AWS_REGION="us-east-1"

# --- DNS (deSEC) -----------------------------------------------------------------
# Token del grupo que entrega el docente. Solo puede escribir el registro
# <grupo>.lab.jplorier.com. Hace falta desde la Parte 3.
export DESEC_API_TOKEN=""
